{
  "Worker": {
    "Schedule": {
      "Cron": "*/1 * * * *",
      "Action": "hello",
      "Arguments": [ "schedule" ]
    },
    "Cleanup": {
      "Directory": "Work",
      "RetainDays": 7,
      "MaxFiles": 1000,
      "MaxSeconds": 60
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "..\\Log\\Template.Worker_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{ThreadId}] - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
