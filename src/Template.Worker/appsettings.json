{
  "Worker": {
    "Schedules": [
      { "Name": "hello", "Cron": "*/1 * * * *", "Action": "hello", "Arguments": [ "schedule" ] },
      { "Name": "cleanup-work", "Cron": "0 3 * * *", "Action": "cleanup", "Arguments": [ "work" ] },
      { "Name": "cleanup-log", "Cron": "30 3 * * 0", "Action": "cleanup", "Arguments": [ "log" ] }
    ],
    "Cleanup": {
      "MaxFiles": 1000,
      "MaxSeconds": 60,
      "Policies": [
        { "Name": "work", "Directory": "Work", "RetainDays": 7, "MaxDepth": 2 },
        { "Name": "log", "Directory": "../Log", "RetainDays": 30, "Extensions": [ ".log" ], "MinSize": 1 }
      ]
    },
    "History": {
      "Directory": "../History"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../Log/Template.Worker_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{ThreadId}] - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
